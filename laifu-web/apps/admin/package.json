{
  "name": "@laifu/admin",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "build:cf": "node scripts/run-opennext.mjs build",
    "preview:cf": "pnpm build:cf && node scripts/run-opennext.mjs preview",
    "deploy:cf": "pnpm build:cf && node scripts/run-opennext.mjs deploy -- --keep-vars",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "html-to-image": "1.11.13",
    "jspdf": "4.2.1",
    "lucide-react": "1.41.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.6",
    "wrangler": "4.129.0"
  }
}
