{
  "name": "@laifu/cms",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 5158",
    "build": "next build --webpack",
    "typecheck": "next typegen && tsc --noEmit",
    "payload:generate-types": "payload generate:types",
    "payload:generate-importmap": "payload generate:importmap",
    "payload:migrate": "payload migrate",
    "payload:migrate:create": "payload migrate:create",
    "seed:home": "tsx --env-file=.env src/scripts/seed-home.ts",
    "seed:navigation": "tsx --env-file=.env src/scripts/seed-navigation.ts",
    "seed:faqs": "tsx --env-file=.env src/scripts/seed-faqs.ts",
    "seed:service": "tsx --env-file=.env src/scripts/seed-service.ts",
    "seed:high-conflict": "tsx --env-file=.env src/scripts/seed-high-conflict.ts",
    "test:high-conflict": "tsx --env-file=.env src/scripts/check-high-conflict.ts",
    "seed": "pnpm seed:faqs && pnpm seed:home && pnpm seed:navigation && pnpm seed:service",
    "publish:dispatch": "tsx --env-file=.env src/scripts/dispatch-publish-events.ts",
    "test": "node --test scripts/check-cms-navigation.test.mjs scripts/check-cms-performance.test.mjs && node --import tsx --test src/config/environment.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@payloadcms/db-postgres": "3.87.0",
    "@payloadcms/live-preview": "3.87.0",
    "@payloadcms/next": "3.87.0",
    "@payloadcms/translations": "3.87.0",
    "@payloadcms/ui": "3.87.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "graphql": "16.14.2",
    "lucide-react": "1.33.0",
    "next": "16.3.0",
    "payload": "3.87.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.20.1",
    "sharp": "0.35.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "25.9.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "tailwindcss": "^4.3.3",
    "tsx": "4.22.4",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.13.0"
  }
}
